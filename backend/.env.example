# Lokal: Connection string (URI) Supabase, Session pooler port 5432
# Vercel: WAJIB pakai Transaction pooler port 6543 (serverless, koneksi pendek)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
JWT_SECRET=ganti-dengan-string-random-panjang
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Upload foto. Supabase > Project Settings > API
# SERVICE_KEY itu service_role, RAHASIA — jangan pernah dikirim ke browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# AI. API key dari https://aistudio.google.com/apikey
# Kalau Gemini membalas 404, ganti GEMINI_MODEL (nama model Google berubah cukup sering).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Diisi pada fase routing (belum dipakai)
MAPBOX_TOKEN=
