# Supabase > Project Settings > Database > Connection string (URI, mode: Session pooler)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
JWT_SECRET=ganti-dengan-string-random-panjang
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Rute jalan kaki (/api/routes/walking). Token SERVER; boleh sama dengan token peta di frontend.
MAPBOX_TOKEN=

# Foto kontribusi. Kosongkan untuk simpan lokal di ./uploads (development).
# Isi untuk Supabase Storage (buat bucket PUBLIK bernama facility-photos).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=facility-photos
PUBLIC_URL=http://localhost:3000

# Asisten AI (POST /api/ai/chat). Kunci dari Google AI Studio. Tanpa kunci, frontend memakai mode dasar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=30

# --- Catatan deploy Vercel ---------------------------------------------------------
# DATABASE_URL di Vercel WAJIB memakai Transaction pooler Supabase port 6543, bukan 5432.
#   Serverless membuka banyak koneksi pendek; port 5432 akan kehabisan kuota koneksi.
# SUPABASE_URL + SUPABASE_SERVICE_KEY WAJIB diisi di Vercel.
#   Tanpa itu foto disimpan ke ./uploads yang bersifat sementara di serverless, dan hilang.
# CORS_ORIGIN diisi domain frontend, jangan dibiarkan kosong (default menjadi '*').
